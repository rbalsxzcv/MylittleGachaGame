# 이 파일을 복사해서 이름을 ".env"로 바꾼 뒤 값을 채우세요.
#   (.env는 .gitignore에 들어 있어서 GitHub에 올라가지 않아요)
# 키 파일 자체는 저장소 밖(예: 내 문서\keys\)에 두는 걸 추천해요.

# ── Vertex AI ──
GOOGLE_CLOUD_PROJECT=my-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\내이름\keys\tinygacha-vertex.json

# 모델 이름 (비워 두면 기본값: 이미지 gemini-nano-banana-2.1 / 텍스트 gemini-3.8-flash)
# TG_IMAGE_MODEL=gemini-nano-banana-2.1
# TG_TEXT_MODEL=gemini-3.8-flash

# 1로 하면 Vertex를 부르지 않고 가짜 그림/글로 흐름만 연습 (비용 0원)
# TG_MOCK=1

# ── 배경 제거 (BRIA RMBG, 선택) ──
# TG_RMBG_MODEL=briaai/RMBG-2.0
# Hugging Face 토큰 (RMBG-2.0은 모델 페이지에서 라이선스 동의 후 토큰 필요)
# HF_TOKEN=hf_xxx

# ── 기타 ──
# TG_DEV_PORT=5050
# TG_NO_BROWSER=1
